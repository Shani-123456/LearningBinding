<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LearningBinding.MainPage">

    <VerticalStackLayout Spacing="20" HorizontalOptions="Center" VerticalOptions="Center">

        <Image Source="{Binding DisplayedStudent.ImageName}" WidthRequest="150" HeightRequest="150" />

        <Label Text="{Binding DisplayedStudent.FirstName}" FontSize="24" HorizontalOptions="Center" />
        <Label Text="{Binding DisplayedStudent.LastName}" FontSize="24" HorizontalOptions="Center" />

        <DatePicker Date="{Binding DisplayedStudent.BirthDate, Mode=TwoWay}" HorizontalOptions="Center" /> 
        
        <Button Text=" תלחץ כדי לשנות את הסטודנט:)" Clicked="OnChangeStudentClicked" HorizontalOptions="Center" />

    </VerticalStackLayout>

</ContentPage>
